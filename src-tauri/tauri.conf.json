{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pusthakam",
  "version": "0.1.0",
  "identifier": "app.pusthakam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pusthakam",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://covers.openlibrary.org; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://covers.openlibrary.org https://openlibrary.org https://www.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A Better Way to Manage Libraries.",
    "longDescription": "Pusthakam is a fast, offline-first desktop library management system for schools, colleges, and community libraries.",
    "category": "Education",
    "copyright": "Copyright © 2026 Melvin Varghese",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3",
          "libayatana-appindicator3-1"
        ],
        "section": "utils"
      }
    }
  }
}
